<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rescue_warehouse">
    <physics name="default_physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
