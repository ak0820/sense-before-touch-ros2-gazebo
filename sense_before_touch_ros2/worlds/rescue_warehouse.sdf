<model name="rubble_1"><static>true</static><pose>4.8 3.45 0.34 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.2400000000000002 2.0 0.68</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2400000000000002 2.0 0.68</size></box></geometry><material><ambient>0.4 0.4 0.43 1</ambient><diffuse>0.4 0.4 0.43 1</diffuse></material></visual></link></model><model name="rubble_2"><static>true</static><pose>6.75 2.45 0.34 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.0 0.6999999999999997 0.68</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.6999999999999997 0.68</size></box></geometry><material><ambient>0.4 0.4 0.43 1</ambient><diffuse>0.4 0.4 0.43 1</diffuse></material></visual></link></model><model name="rubble_3"><static>true</static><pose>8.33 3.41 0.34 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.7800000000000002 0.6200000000000001 0.68</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7800000000000002 0.6200000000000001 0.68</size></box></geometry><material><ambient>0.4 0.4 0.43 1</ambient><diffuse>0.4 0.4 0.43 1</diffuse></material></visual></link></model><model name="medical_zone"><static>true</static><pose>10.47 5.64 0.015 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.25 0.9 0.03</size></box></geometry><material><ambient>0.16 0.51 0.78 1</ambient><diffuse>0.16 0.51 0.78 1</diffuse></material></visual></link></model><model name="battery_zone"><static>true</static><pose>10.47 3.62 0.015 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.25 0.9 0.03</size></box></geometry><material><ambient>0.9 0.34 0.2 1</ambient><diffuse>0.9 0.34 0.2 1</diffuse></material></visual></link></model><model name="food_zone"><static>true</static><pose>10.47 1.57 0.015 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.25 0.9 0.03</size></box></geometry><material><ambient>0.31 0.76 0.39 1</ambient><diffuse>0.31 0.76 0.39 1</diffuse></material></visual></link></model><model name="box_a"><static>true</static><pose>3.14 5.68 0.15 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.27 0.27 0.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.27 0.27 0.3</size></box></geometry><material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.75 0.72 0.65 1</diffuse></material></visual></link></model><model name="box_b"><static>true</static><pose>6.75 5.35 0.15 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.27 0.27 0.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.27 0.27 0.3</size></box></geometry><material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.75 0.72 0.65 1</diffuse></material></visual></link></model><model name="box_c"><static>true</static><pose>3.1 1.98 0.15 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.27 0.27 0.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.27 0.27 0.3</size></box></geometry><material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.75 0.72 0.65 1</diffuse></material></visual></link></model>
  <model name="rescue_rover">
    <pose>1.05 1.08 0 0 0 0</pose>
    <link name="chassis">
      <pose>0 0 0.28 0 0 0</pose>
      <inertial><mass>2.2</mass><inertia><ixx>0.04</ixx><iyy>0.07</iyy><izz>0.08</izz></inertia></inertial>
      <collision name="body_collision"><geometry><box><size>0.48 0.36 0.15</size></box></geometry></collision>
      <visual name="body_visual"><geometry><box><size>0.48 0.36 0.15</size></box></geometry><material><ambient>0.09 0.68 0.79 1</ambient><diffuse>0.09 0.68 0.79 1</diffuse></material></visual>
      <visual name="camera_visual"><pose>0.14 0 0.13 0 0 0</pose><geometry><box><size>0.12 0.12 0.13</size></box></geometry><material><ambient>0.09 0.11 0.14 1</ambient><diffuse>0.09 0.11 0.14 1</diffuse></material></visual>
    </link>
    <link name="left_wheel"><pose>0 0.235 0.125 1.57079632679 0 0</pose>
      <inertial><mass>0.35</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.125</radius><length>0.065</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.125</radius><length>0.065</length></cylinder></geometry><material><ambient>0.06 0.06 0.08 1</ambient><diffuse>0.08 0.08 0.11 1</diffuse></material></visual>
    </link>
    <link name="right_wheel"><pose>0 -0.235 0.125 1.57079632679 0 0</pose>
      <inertial><mass>0.35</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.125</radius><length>0.065</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.125</radius><length>0.065</length></cylinder></geometry><material><ambient>0.06 0.06 0.08 1</ambient><diffuse>0.08 0.08 0.11 1</diffuse></material></visual>
    </link>
    <link name="rear_caster">
      <pose>-0.20 0 0.085 0 0 0</pose>
      <inertial><mass>0.09</mass><inertia><ixx>0.00035</ixx><iyy>0.00035</iyy><izz>0.00035</izz></inertia></inertial>
      <collision name="caster_collision"><geometry><sphere><radius>0.08</radius></sphere></geometry><surface><friction><ode><mu>0.08</mu><mu2>0.08</mu2></ode></friction></surface></collision>
      <visual name="caster_visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>0.22 0.23 0.26 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
    </link>
    <joint name="caster_joint" type="ball"><parent>chassis</parent><child>rear_caster</child></joint>
    <joint name="left_wheel_joint" type="revolute"><parent>chassis</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="right_wheel_joint" type="revolute"><parent>chassis</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.47</wheel_separation><wheel_radius>0.125</wheel_radius>
      <topic>/model/rescue_rover/cmd_vel</topic><odom_topic>/model/rescue_rover/odometry</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>2</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>rescue_rover/chassis</robot_base_frame>
      <odom_topic>/model/rescue_rover/ground_truth</odom_topic>
      <tf_topic>/model/rescue_rover/ground_truth_tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</world>
</sdf>
